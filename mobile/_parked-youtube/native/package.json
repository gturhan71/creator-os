{
  "name": "creator-os-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Creator OS - backend-free native mobile app (Capacitor + on-device SQLite)",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "serve": "python3 -m http.server 4174 --directory www",
    "cap:sync": "npx cap sync",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "8.0.2",
    "@revenuecat/purchases-capacitor": "^13.6.0",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "jeep-sqlite": "^2.8.0",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "sql.js": "1.11.0"
    }
  }
}
